GridSpacerWidgetClass rootFrame {
 visible 0
 position 0 0
 size 100 20
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style RL_Clean_outline
 Padding 1
 Margin 1
 "Size To Content H" 1
 "Size To Content V" 1
 Columns 1
 Rows 2
 {
  GridSpacerWidgetClass top {
   ignorepointer 1
   position 10 10
   size 48 48
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   "Size To Content H" 1
   "Size To Content V" 1
   Columns 2
   Rows 1
   {
    ImageWidgetClass icon {
     ignorepointer 1
     position 10 10
     size 16 16
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     stretch 1
    }
    TextWidgetClass name {
     visible 1
     ignorepointer 1
     position 10 10
     size 48 16
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "Displayname"
     "size to text h" 1
     "size to text v" 1
    }
   }
  }
  GridSpacerWidgetClass bottom {
   visible 1
   ignorepointer 1
   position 10 10
   size 48 48
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   "Size To Content H" 1
   "Size To Content V" 1
   Columns 1
   Rows 1
   {
    TextWidgetClass distance {
     visible 1
     ignorepointer 1
     position 10 10
     size 48 15
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "1000m"
     "size to text h" 1
     "size to text v" 0
    }
   }
  }
 }
}